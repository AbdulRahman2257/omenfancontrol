#!/usr/bin/env bash
set -e

INSTALL_DIR="/opt/omenfancontrol"
DATA_DIR="/var/lib/omenfancontrol"
SERVICE="omenfancontrol"

case "$1" in
    configure)
        mkdir -p "$DATA_DIR"
        chmod 755 "$DATA_DIR"

        if command -v python3.11 &>/dev/null; then
            python3.11 -m venv "$INSTALL_DIR/.venv"
        else
            python3 -m venv "$INSTALL_DIR/.venv"
        fi

        "$INSTALL_DIR/.venv/bin/pip" install --upgrade pip --quiet
        "$INSTALL_DIR/.venv/bin/pip" install PyQt6 --quiet

        cp "$INSTALL_DIR/install/omenfancontrol.service" \
            /etc/systemd/system/omenfancontrol.service
        systemctl daemon-reload
        systemctl enable "$SERVICE"
        systemctl start  "$SERVICE" || true

        cp "$INSTALL_DIR/install/omenfancontrol-gui.desktop" \
            /usr/share/applications/omenfancontrol.desktop

        cat > /usr/local/bin/omenfancontrol <<LAUNCHEOF
#!/usr/bin/env bash
cd /opt/omenfancontrol
exec /opt/omenfancontrol/.venv/bin/python3 \
     /opt/omenfancontrol/main.py "\$@"
LAUNCHEOF
        chmod +x /usr/local/bin/omenfancontrol
        ;;
esac

exit 0